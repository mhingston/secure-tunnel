<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Install as a system LaunchDaemon after creating the data directory with
       owner root:wheel and mode 0700. -->
  <key>Label</key>
  <string>com.example.secure-tunnel-server</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Library/PrivilegedHelperTools/secure-tunnel-server</string>
    <string>serve</string>
    <string>--config</string>
    <string>/Library/Application Support/SecureTunnel/server.toml</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>StandardOutPath</key><string>/var/log/secure-tunnel-server.log</string>
  <key>StandardErrorPath</key><string>/var/log/secure-tunnel-server-error.log</string>
</dict>
</plist>
